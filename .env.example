# Public storefront URL used for canonical links, sitemap, and social metadata.
NEXT_PUBLIC_SITE_URL=https://aylee.store

# Server-only custom Laravel commerce API. Do not prefix with NEXT_PUBLIC_.
COMMERCE_API_URL=https://admin.aylee.store

# Optional server-only token for protected backend-to-backend operations.
COMMERCE_API_TOKEN=

# Optional webhook secret for on-demand cache revalidation.
REVALIDATION_SECRET=

# Public Stripe key is only needed if the backend returns a client-side flow.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
